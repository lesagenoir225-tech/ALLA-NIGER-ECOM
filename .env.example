# Fichier d'exemple — ne contient aucun secret réel.
#
# Copier en `.env` (ignoré par Git) et renseigner les valeurs depuis
# Supabase → Project Settings → API Keys.

# --- Serveur (Node / API) -------------------------------------------------
# Lecture ET écriture. La clé service_role contourne RLS : elle ne doit
# JAMAIS être exposée au navigateur ni versionnée.
SUPABASE_URL=https://VOTRE-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Clé publique, utilisée en repli pour la lecture si la clé service_role
# n'est pas fournie.
SUPABASE_ANON_KEY=sb_publishable_...

# --- Navigateur (Vite, préfixe VITE_ obligatoire) -------------------------
# Uniquement des valeurs publiques : tout ce qui commence par VITE_ finit
# dans le bundle JavaScript envoyé aux visiteurs.
VITE_SUPABASE_URL=https://VOTRE-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# --- Administration -------------------------------------------------------
# Mot de passe de l'interface /#/admin (défaut historique à changer).
ADMIN_PASSWORD=changez-moi
